# Optional Profile patch for the standalone provider.
# Copy this file to the Profile's cordis.patch.yml and adjust endpoint/model.
# The Profile package.json must list this package as a dependency first.
- id: web
  config:
    searchProvider: codex-local
- insert:
    - id: web-search-codex
      name: '@lyd123qw2008/dsh-web-search-codex'
      config:
        apiKeyEnv: OPENAI_API_KEY
        baseURL: http://127.0.0.1:18085/v1
        model: gpt-5.6-luna
        searchContextSize: medium
        stream: true
        maxOutputTokens: 4096
